# Supabase URL for connecting to your Supabase project
VITE_SUPABASE_URL=

# Supabase Anon Key for public access
VITE_SUPABASE_ANON_KEY=

# SMTP Email address for sending OTPs
SMTP_EMAIL=

# SMTP App Password (e.g. from Google App Passwords)
SMTP_APP_PASSWORD=

# Gemini API Key for AI tools
GEMINI_API_KEY=
